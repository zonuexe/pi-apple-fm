{
  "name": "@zonuexe/pi-apple-fm",
  "version": "0.0.1",
  "description": "Apple Foundation Models (fm chat) extension for Pi coding agent on macOS",
  "type": "module",
  "main": "./index.ts",
  "types": "./dist/index.d.ts",
  "keywords": [
    "pi-package",
    "apple-foundation-models",
    "apple-intelligence",
    "foundation-models",
    "fm-chat",
    "macos",
    "ai"
  ],
  "author": "USAMI Kenta",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zonuexe/pi-apple-fm"
  },
  "bugs": {
    "url": "https://github.com/zonuexe/pi-apple-fm/issues"
  },
  "homepage": "https://github.com/zonuexe/pi-apple-fm#readme",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "mutate": "PI_APPLE_FM_SKIP_LIVE=1 stryker run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "changelogPath": "./CHANGELOG.md"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/node": "^26.6.6",
    "typebox": "^1.4.6",
    "typescript": "^6.0.3"
  }
}
